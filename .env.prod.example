# ============================================================
# YLUME — PRODUÇÃO / LIGHTSAIL
# Copie este arquivo para .env NO SERVIDOR e preencha os valores.
# Nunca envie o .env real ao Git.
# ============================================================

# DOMÍNIOS
APP_DOMAIN=app.ylume.dev.br
API_DOMAIN=api.ylume.dev.br
N8N_DOMAIN=automation.ylume.dev.br

# E-mail usado pelo Let's Encrypt.
ACME_EMAIL=seu-email@exemplo.com


# POSTGRESQL
POSTGRES_USER=ylume
POSTGRES_PASSWORD=GERE_UMA_SENHA_FORTE
POSTGRES_DB=ylume_db

# Banco separado utilizado pelo n8n.
N8N_DB=ylume_n8n


# N8N
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest

# Gere uma vez e NÃO troque depois que o n8n estiver em uso.
N8N_ENCRYPTION_KEY=GERE_UMA_CHAVE_FORTE

N8N_TIMEOUT_SECONDS=180


# AUTENTICAÇÃO YLUME
JWT_SECRET_KEY=GERE_UMA_CHAVE_FORTE
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=ylume_session


# IMPORTANTE
# Em produção estes valores são fixados pelo docker-compose:
# AUTH_COOKIE_SECURE=true
# ALLOW_LOCAL_PROJECT_CLAIM=false
